# Copie este arquivo para .env (na mesma pasta) e preencha.
# O .env NUNCA vai para o GitHub (está no .gitignore).

# Chave da API da Anthropic, para a IA ler os itens dos cupons (Fase 2).
ANTHROPIC_API_KEY=

# Onde fica o banco (fora do Google Drive!). Padrão: <projeto>\data
# CF_PASTA_DADOS=D:\Projetos\ControleFinanceiro\data

# Backup local. Padrão: <projeto>\BackUp
# CF_PASTA_BACKUP=D:\Projetos\ControleFinanceiro\BackUp

# Cópia dos backups no Google Drive para computador (deixe vazio para não copiar).
CF_PASTA_BACKUP_DRIVE=G:\Meu Drive\ControleFinanceiro\BackUp

# Modo DEMONSTRAÇÃO: usa um banco separado (financeiro_demo.db) com dados
# fictícios, nunca os seus dados reais. Deixe vazio/0 no app instalado.
# CF_MODO_DEMO=1
